{
  "name": "nexture",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @nexture/db migrate"
  },
  "devDependencies": {
    "turbo": "2.11.6",
    "typescript": "5.9.3",
    "prettier": "^3.6.0"
  },
  "pnpm": {
